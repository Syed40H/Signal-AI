# Render Postgres: copy the External Database URL from your database's page in the Render dashboard.
# The same database is used for local development and production.
# Format: postgresql://USER:PASSWORD@HOST.render.com/DATABASE
DATABASE_URL=

# Free key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Free key from https://resend.com (API Keys page)
RESEND_API_KEY=
# Without your own domain, Resend only sends to the email you signed up with
DIGEST_RECIPIENT=you@example.com
# Optional, defaults to Resend's testing sender
# EMAIL_FROM=Signal AI <onboarding@resend.dev>
