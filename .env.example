# Postgres from docker-compose, reached from your host machine.
# Inside `docker compose`, the app container overrides this to point at the `db` service.
DATABASE_URL=postgresql://signalai:signalai@localhost:5432/signalai

OPENAI_API_KEY=
YOUTUBE_API_KEY=

# Resend or SendGrid
EMAIL_API_KEY=
EMAIL_FROM=you@yourdomain.com

# Single recipient for now
DIGEST_RECIPIENT=you@yourdomain.com
